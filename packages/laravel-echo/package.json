{
    "name": "laravel-echo",
    "version": "2.4.0",
    "description": "Laravel Echo library for beautiful Pusher and Socket.IO integration",
    "keywords": [
        "laravel",
        "pusher",
        "ably"
    ],
    "homepage": "https://github.com/laravel/echo/tree/2.x/packages/laravel-echo",
    "repository": {
        "type": "git",
        "url": "https://github.com/laravel/echo"
    },
    "license": "MIT",
    "author": {
        "name": "Taylor Otwell"
    },
    "type": "module",
    "main": "dist/echo.common.js",
    "module": "dist/echo.js",
    "types": "dist/echo.d.ts",
    "scripts": {
        "build": "vite build && FORMAT=iife vite build",
        "dev": "vite dev",
        "lint": "eslint --config eslint.config.mjs \"src/**/*.ts\"",
        "prepublish": "pnpm run build",
        "release": "vitest --run && pnpm publish --no-git-checks",
        "test": "vitest",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.58.13",
        "@types/jquery": "^3.5.32",
        "@types/node": "^24.13.3",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "axios": "^1.18.0",
        "eslint": "^10.8.1",
        "jsdom": "^30.0.0",
        "prettier": "^3.5.3",
        "pusher-js": "^8.4.0",
        "socket.io-client": "^4.8.3",
        "typescript": "^5.8.3",
        "unplugin-dts": "^1.0.3",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "pusher-js": "*",
        "socket.io-client": "*"
    },
    "peerDependenciesMeta": {
        "pusher-js": {
            "optional": true
        },
        "socket.io-client": {
            "optional": true
        }
    },
    "typesVersions": {
        "*": {
            "socket.io-client": [],
            "pusher-js": []
        }
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "exports": {
        ".": {
            "types": "./dist/echo.d.ts",
            "import": "./dist/echo.js",
            "require": "./dist/echo.common.js"
        },
        "./iife": "./dist/echo.iife.js"
    }
}
