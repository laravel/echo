{
    "name": "@laravel/echo-vue",
    "version": "2.6.3",
    "description": "Vue hooks for seamless integration with Laravel Echo.",
    "keywords": [
        "laravel",
        "pusher",
        "ably",
        "vue"
    ],
    "homepage": "https://github.com/laravel/echo/tree/2.x/packages/vue",
    "repository": {
        "type": "git",
        "url": "https://github.com/laravel/echo"
    },
    "license": "MIT",
    "author": {
        "name": "Taylor Otwell"
    },
    "type": "module",
    "main": "dist/index.common.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "vp build && FORMAT=iife vp build && tsc -p tsconfig.build.json",
        "dev": "vp dev",
        "prepublish": "pnpm run build",
        "release": "vp test --run && pnpm publish --no-git-checks",
        "test": "vp test"
    },
    "devDependencies": {
        "@types/node": "^24.13.3",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^30.0.0",
        "laravel-echo": "workspace:^",
        "pusher-js": "^8.4.0",
        "socket.io-client": "^4.8.1",
        "typescript": "catalog:",
        "vite-plus": "catalog:",
        "vue": "^3.5.41"
    },
    "peerDependencies": {
        "pusher-js": "*",
        "socket.io-client": "*",
        "vue": "^3.0.0"
    },
    "peerDependenciesMeta": {
        "pusher-js": {
            "optional": true
        },
        "socket.io-client": {
            "optional": true
        }
    },
    "typesVersions": {
        "*": {
            "socket.io-client": [],
            "pusher-js": []
        }
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.common.js"
        }
    },
    "files": [
        "dist",
        "resources/boost"
    ]
}
