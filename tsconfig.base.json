{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "lib": ["dom", "es2020"],
        "module": "ES2020",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "sourceMap": false,
        "strict": true,
        "strictPropertyInitialization": false,
        "target": "ES2020",
        "verbatimModuleSyntax": true
    }
}
